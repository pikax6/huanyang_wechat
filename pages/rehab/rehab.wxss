/* 还阳页样式 */
.page-container {
  min-height: 100vh;
  padding: 24rpx 32rpx 120rpx;
}

.card {
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx var(--color-shadow);
  margin-bottom: 24rpx;
}

/* 还阳值头部 */
.yang-header {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.yang-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.yang-level {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.level-icon { font-size: 36rpx; }
.level-text { font-size: 32rpx; font-weight: 700; color: var(--color-text-primary); }

.yang-value {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-primary);
}

.yang-progress {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.progress-bar {
  height: 16rpx;
  background: var(--color-progress-bg);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.progress-text {
  font-size: 22rpx;
  color: var(--color-text-light);
}

/* 区块 */
.section { margin-bottom: 32rpx; }

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.add-btn {
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-weight: 600;
}

/* 计划卡片 */
.plan-list { display: flex; flex-direction: column; gap: 24rpx; }

.plan-card {
  padding: 28rpx;
}

.plan-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.plan-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.plan-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.plan-name { font-size: 30rpx; font-weight: 600; color: var(--color-text-primary); }
.plan-category { font-size: 22rpx; color: var(--color-text-light); }

.plan-streak { display: flex; align-items: baseline; gap: 4rpx; }
.streak-num { font-size: 40rpx; font-weight: 800; }
.streak-label { font-size: 24rpx; color: var(--color-text-secondary); }

.plan-progress { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.plan-progress .progress-bar { flex: 1; }
.plan-days { font-size: 24rpx; color: var(--color-text-secondary); white-space: nowrap; }

.plan-insight {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.insight-icon { font-size: 24rpx; }
.insight-text { font-size: 24rpx; color: var(--color-text-secondary); flex: 1; }

.plan-action { }
.checkin-btn {
  text-align: center;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s;
}
.checkin-btn:active { transform: scale(0.97); }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 60rpx 32rpx;
}
.empty-emoji { font-size: 64rpx; }
.empty-text { font-size: 28rpx; color: var(--color-text-secondary); }
.empty-hint { font-size: 24rpx; color: var(--color-text-light); text-align: center; }

/* 急救包 */
.rescue-list { display: flex; flex-direction: column; gap: 16rpx; }
.rescue-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx var(--color-shadow);
}
.rescue-card:active { transform: scale(0.98); }
.rescue-icon { font-size: 40rpx; }
.rescue-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.rescue-name { font-size: 28rpx; font-weight: 600; color: var(--color-text-primary); }
.rescue-desc { font-size: 24rpx; color: var(--color-text-secondary); }
.rescue-arrow { font-size: 40rpx; color: var(--color-text-light); }

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}
.modal-mask.show { opacity: 1; pointer-events: auto; }

.modal-content {
  width: 100%;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s ease;
}
.modal-mask.show .modal-content { transform: translateY(0); }

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 32rpx;
  color: var(--color-text-primary);
}

.modal-section { margin-bottom: 32rpx; }
.modal-label { font-size: 28rpx; color: var(--color-text-secondary); margin-bottom: 16rpx; display: block; }

.habit-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}
.habit-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 8rpx;
  border-radius: 16rpx;
  border: 3rpx solid;
}
.habit-icon { font-size: 40rpx; }
.habit-name { font-size: 24rpx; color: var(--color-text-primary); }

.mode-list { display: flex; flex-direction: column; gap: 16rpx; }
.mode-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 3rpx solid;
}
.mode-icon { font-size: 36rpx; }
.mode-info { flex: 1; }
.mode-name { font-size: 28rpx; font-weight: 600; color: var(--color-text-primary); }
.mode-desc { font-size: 24rpx; color: var(--color-text-secondary); }

.day-options { display: flex; gap: 16rpx; flex-wrap: wrap; }
.day-item {
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  border: 3rpx solid;
  font-size: 28rpx;
  font-weight: 600;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.modal-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.modal-btn.cancel { background: rgba(0,0,0,0.04); }
.modal-btn.next { color: #fff; }

.bottom-space { height: 40rpx; }
