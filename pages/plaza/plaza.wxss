/* 广场页样式 */
.page-container {
  min-height: 100vh;
  padding: 24rpx 32rpx 120rpx;
}

/* 实时陪伴状态条 */
.companion-bar {
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 20rpx var(--color-shadow);
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.companion-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.companion-icon {
  font-size: 32rpx;
}

.companion-text {
  font-size: 26rpx;
  color: var(--color-text-primary);
}

/* 卡片 */
.card {
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx var(--color-shadow);
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 24rpx;
}

/* 区块头部（带提示） */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-header .section-title {
  margin-bottom: 0;
}

.section-tip {
  font-size: 22rpx;
  color: var(--color-text-light);
}

/* 我的小组卡片 */
.my-group-card {
  border-left: 6rpx solid var(--color-primary);
}

.my-group-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.my-group-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
}

.tag-icon {
  font-size: 24rpx;
}

.tag-name {
  font-size: 24rpx;
  font-weight: 600;
}

.tag-leave {
  font-size: 22rpx;
  opacity: 0.6;
  padding: 0 4rpx;
}

.tag-leave:active {
  opacity: 1;
}

/* 小组专属feed */
.my-feed-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feed-item {
  padding: 20rpx;
  background: rgba(0,0,0,0.02);
  border-radius: 16rpx;
}

.feed-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.feed-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feed-avatar-icon {
  font-size: 28rpx;
}

.feed-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.feed-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.feed-days {
  font-size: 20rpx;
}

.feed-time {
  font-size: 22rpx;
  color: var(--color-text-light);
}

.feed-text {
  font-size: 26rpx;
  color: var(--color-text-primary);
  line-height: 1.5;
}

.feed-empty {
  text-align: center;
  padding: 20rpx;
}

.feed-empty .empty-text {
  font-size: 24rpx;
  color: var(--color-text-light);
}

/* 打卡广场 */
.checkin-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.checkin-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.checkin-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.checkin-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkin-avatar-icon {
  font-size: 32rpx;
}

.checkin-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.checkin-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.checkin-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.checkin-days {
  font-size: 22rpx;
  font-weight: 600;
}

.checkin-time {
  font-size: 22rpx;
  color: var(--color-text-light);
}

.checkin-text {
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.6;
  padding-left: 80rpx;
}

.plaza-hint {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-light);
}

/* 主题小组 */
.group-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.group-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(0, 0, 0, 0.02);
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.group-item:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.group-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.group-icon {
  font-size: 36rpx;
}

.group-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.group-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.group-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.group-count {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.group-desc {
  font-size: 22rpx;
  color: var(--color-text-light);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-btn {
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.group-btn:active {
  transform: scale(0.95);
}

.group-hint {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(0,0,0,0.02);
  border-radius: 12rpx;
  text-align: center;
}

.group-hint text {
  font-size: 22rpx;
  color: var(--color-text-light);
}

/* 每日金句 */
.quote-card {
  padding: 40rpx 32rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.quote-mark {
  font-size: 56rpx;
  color: var(--color-primary);
  line-height: 1;
  font-weight: 700;
}

.quote-text {
  font-size: 30rpx;
  color: var(--color-text-primary);
  line-height: 1.7;
  font-weight: 500;
}

/* 底部留白 */
.bottom-space {
  height: 40rpx;
}
