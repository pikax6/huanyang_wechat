/* 装扮商店样式 */
.page-container {
  min-height: 100vh;
  padding: 24rpx 32rpx 120rpx;
}

/* === 积分头部 === */
.points-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx var(--color-shadow);
}

.points-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.points-icon {
  font-size: 48rpx;
}

.points-texts {
  display: flex;
  flex-direction: column;
}

.points-num {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-primary);
  line-height: 1.1;
}

.points-label {
  font-size: 22rpx;
  color: var(--color-text-light);
}

.points-tip {
  padding: 8rpx 20rpx;
  background: var(--color-primary);
  border-radius: 32rpx;
  opacity: 0.15;
}

.tip-text {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 600;
}

/* === 小人预览区 === */
.preview-card {
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx var(--color-shadow);
}

.preview-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.preview-hint {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 600;
  padding: 4rpx 16rpx;
  background: var(--color-primary);
  border-radius: 20rpx;
  opacity: 0.15;
}

.preview-stage {
  min-height: 400rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transition: background 0.5s ease;
}

.preview-tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-light);
}

/* === 分类 === */
.category-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx var(--color-shadow);
}

.category-tabs {
  display: inline-flex;
  padding: 8rpx;
  gap: 4rpx;
  border-radius: 24rpx;
}

.cat-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 16rpx 28rpx;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.cat-tab.active {
  background: rgba(0,0,0,0.04);
}

.cat-icon {
  font-size: 32rpx;
}

.cat-name {
  font-size: 22rpx;
  font-weight: 600;
}

/* === 道具列表 === */
.item-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item-card {
  position: relative;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx var(--color-shadow);
  border: 2rpx solid transparent;
  transition: transform 0.2s, border-color 0.2s;
  overflow: hidden;
}

.item-card:active {
  transform: scale(0.98);
}

.item-card.trying {
  border-color: var(--color-primary);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.12);
}

/* 试戴/已装备 徽章 */
.trying-badge,
.equipped-badge {
  position: absolute;
  top: 0;
  right: 0;
  padding: 6rpx 18rpx;
  border-radius: 0 20rpx 0 16rpx;
  font-size: 20rpx;
  color: #fff;
  font-weight: 600;
  z-index: 2;
}

.trying-badge {
  animation: badge-pulse 1.5s ease-in-out infinite;
}

@keyframes badge-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.item-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.item-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-price {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.price-icon {
  font-size: 24rpx;
}

.price-num {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.item-price.free {
  padding: 4rpx 16rpx;
  background: var(--color-primary);
  border-radius: 20rpx;
  opacity: 0.2;
}

.free-text {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.item-btn {
  padding: 14rpx 36rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.item-btn:active {
  transform: scale(0.96);
}

.item-btn.equip {
  background: transparent;
}

.item-btn.equip.equipped {
  color: #fff;
}

/* 积分不足：禁用按钮 */
.item-btn.disabled {
  background: var(--color-border);
  color: var(--color-text-light);
  opacity: 0.6;
}

/* 默认道具已装备标识 */
.item-btn.default-btn {
  background: transparent;
  color: var(--color-text-light);
  border-color: var(--color-border);
  font-weight: 500;
}

/* === 已拥有提示 === */
.owned-tip {
  text-align: center;
  margin-top: 32rpx;
}

.owned-text {
  font-size: 24rpx;
  color: var(--color-text-light);
}

.bottom-space {
  height: 40rpx;
}
