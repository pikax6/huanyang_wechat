/* 心情页样式 */
.page-container {
  min-height: 100vh;
  padding: 24rpx 32rpx 120rpx;
}

.card {
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx var(--color-shadow);
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 24rpx;
}

/* 心情选择 */
.mood-selector {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.mood-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 8rpx;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.mood-item.selected { transform: scale(1.05); }
.mood-emoji { font-size: 48rpx; }
.mood-label { font-size: 22rpx; }

/* 场景标签 */
.scene-section { margin-top: 24rpx; }
.scene-title { font-size: 26rpx; color: var(--color-text-secondary); margin-bottom: 16rpx; display: block; }
.scene-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.scene-tag {
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  border: 2rpx solid;
  font-size: 24rpx;
  transition: all 0.2s;
}

/* 文字记录 */
.note-section { margin-top: 24rpx; }
.note-input {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  border: 2rpx solid;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}
.save-btn {
  text-align: center;
  padding: 20rpx;
  border-radius: 16rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* 趋势图 */
.trend-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
  padding: 0 8rpx;
}
.trend-bar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}
.trend-bar {
  width: 40rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  transition: height 0.5s ease;
  min-height: 20rpx;
}
.trend-empty {
  width: 40rpx;
  height: 20rpx;
  background: var(--color-progress-bg);
  border-radius: 4rpx;
}
.trend-emoji { font-size: 24rpx; }
.trend-day { font-size: 22rpx; color: var(--color-text-light); }

/* 洞察 */
.insights-list { display: flex; flex-direction: column; gap: 16rpx; }
.insight-item {
  display: flex;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
}
.insight-icon { font-size: 28rpx; }
.insight-content { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.insight-text { font-size: 26rpx; color: var(--color-text-primary); }
.insight-tip { font-size: 22rpx; color: var(--color-text-light); }

.insights-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 40rpx 0;
}
.empty-emoji { font-size: 56rpx; }
.empty-text { font-size: 26rpx; color: var(--color-text-secondary); }
.empty-hint { font-size: 22rpx; color: var(--color-text-light); }

/* 热力图 */
.heatmap { display: flex; flex-direction: column; gap: 16rpx; }
.heatmap-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}
.heatmap-cell {
  aspect-ratio: 1;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.heatmap-cell.has-data { min-height: 56rpx; }
.heatmap-day { font-size: 20rpx; color: rgba(255,255,255,0.8); }

.heatmap-legend {
  display: flex;
  align-items: center;
  gap: 12rpx;
  justify-content: center;
}
.legend-label { font-size: 22rpx; color: var(--color-text-light); }
.legend-bar {
  width: 200rpx;
  height: 12rpx;
  border-radius: 6rpx;
}

.bottom-space { height: 40rpx; }
